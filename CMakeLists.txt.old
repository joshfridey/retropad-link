cmake_minimum_required(VERSION 3.13)

project(retropad_link C CXX ASM)

set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 17)


# ============================================================================
# JOYPADOS LOCATION
# ============================================================================
#
# By default, assume JoypadOS is next to this project:
#
#   ~/Downloads/
#       joypad-os/
#       retropad-link/
#
# You can override this at configure time with:
#
#   -DJOYPADOS_DIR=/path/to/joypad-os
#

if(NOT DEFINED JOYPADOS_DIR)
    get_filename_component(
        JOYPADOS_DIR
        "${CMAKE_CURRENT_LIST_DIR}/../joypad-os"
        ABSOLUTE
    )
endif()

message(STATUS "JoypadOS directory: ${JOYPADOS_DIR}")


# ============================================================================
# PICO SDK
# ============================================================================

include(${JOYPADOS_DIR}/src/lib/pico-sdk/external/pico_sdk_import.cmake)

pico_sdk_init()


# ============================================================================
# IMPORT JOYPADOS BUILD DEFINITIONS
# ============================================================================
#
# We use JoypadOS's source definitions and helper functions, but we do NOT
# modify its CMakeLists.txt.
#

include(${JOYPADOS_DIR}/src/CMakeLists.txt)


# ============================================================================
# RETROPAD LINK
# ============================================================================

add_executable(retropad_link)


# ============================================================================
# COMPILE DEFINITIONS
# ============================================================================
#
# For now, RetroPad Link uses the existing SNES2USB configuration path because
# our current working firmware depends on the native SNES host + USB device
# setup.
#
# Later we can replace this with a dedicated compatibility/config layer.
#

target_compile_definitions(
    retropad_link
    PRIVATE
    CONFIG_SNES2USB=1
    CONFIG_USB=1
    DISABLE_USB_HOST=1
)


# ============================================================================
# SOURCES
# ============================================================================

target_sources(
    retropad_link
    PUBLIC

    ${CORE_SOURCES}
    ${USB_DEVICE_SOURCES}
    ${SNES_HOST_SOURCES}

    ${CMAKE_CURRENT_LIST_DIR}/src/app.c

    ${JOYPADOS_DIR}/src/core/services/display/display.c
    ${JOYPADOS_DIR}/src/core/services/display/display_i2c.c
)


# ============================================================================
# INCLUDE DIRECTORIES
# ============================================================================

target_include_directories(
    retropad_link
    PUBLIC

    ${CMAKE_CURRENT_LIST_DIR}/src

    ${JOYPADOS_DIR}/src
    ${JOYPADOS_DIR}/src/usb/usbd
    ${JOYPADOS_DIR}/src/native/host/snes
    ${JOYPADOS_DIR}/src/lib/SNESpad/src
)


# ============================================================================
# LIBRARIES
# ============================================================================

target_link_libraries(
    retropad_link
    PRIVATE

    pico_stdlib
    pico_multicore
    hardware_pio
    hardware_i2c
    pico_rand

    tinyusb_device
    tinyusb_board
)


# ============================================================================
# JOYPADOS COMMON TARGET SETUP
# ============================================================================

joypad_target_common(retropad_link)


# ============================================================================
# OUTPUT
# ============================================================================

pico_add_extra_outputs(retropad_link)
