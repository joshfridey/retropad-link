#include "joystick_diag.h"

#include "pico/stdlib.h"

#include <math.h>
#include <stdlib.h>
#include <string.h>


// ============================================================================
// PROFILES
// ============================================================================
//
// N64 thresholds are starting points based on commonly quoted figures for
// OEM sticks (new ~80-85, noticeably worn below ~65). Tune as needed.
//

const joystick_profile_t joystick_profile_n64 = {
    .name = "N64",
    .full_scale = 100,
    .reference_reach = 84,
    .good_reach = 75,
    .fair_reach = 65,
    .center_tolerance = 6,
};


// ============================================================================
// REST DETECTION
// ============================================================================

// Stick must hold still this long before its position counts as "at rest".
#define REST_SETTLE_US      300000

// Movement of this many units or less still counts as holding still.
#define REST_JITTER         1


// ============================================================================
// STATE
// ============================================================================

static joystick_diag_t diag;

static const joystick_profile_t* profile =
    &joystick_profile_n64;

static uint64_t steady_since_us =
    0;


// ============================================================================
// RESET
// ============================================================================

void joystick_diag_reset(const joystick_profile_t* new_profile)
{
    memset(
        &diag,
        0,
        sizeof(diag)
    );


    if (new_profile) {
        profile = new_profile;
    }


    steady_since_us =
        0;
}


// ============================================================================
// UPDATE
// ============================================================================

static void update_reach(
    int16_t* reach,
    int16_t value
)
{
    if (value > *reach) {
        *reach = value;
    }
}


bool joystick_diag_update(
    int16_t x,
    int16_t y
)
{
    uint64_t now =
        time_us_64();


    bool moved =
        abs(x - diag.x) > REST_JITTER ||
        abs(y - diag.y) > REST_JITTER;


    bool changed =
        x != diag.x ||
        y != diag.y;


    diag.x = x;
    diag.y = y;


    // ------------------------------------------------------------------------
    // CARDINAL REACH
    // ------------------------------------------------------------------------

    update_reach(&diag.reach_right, x);
    update_reach(&diag.reach_left, -x);
    update_reach(&diag.reach_up, y);
    update_reach(&diag.reach_down, -y);


    // ------------------------------------------------------------------------
    // OUTLINE TRACE
    // ------------------------------------------------------------------------

    float radius =
        sqrtf((float)x * x + (float)y * y);


    if (radius >= 1.0f) {

        float angle =
            atan2f((float)y, (float)x);


        if (angle < 0.0f) {
            angle += 2.0f * (float)M_PI;
        }


        int bin =
            (int)(angle * JOYSTICK_DIAG_TRACE_BINS / (2.0f * (float)M_PI) + 0.5f) %
            JOYSTICK_DIAG_TRACE_BINS;


        uint8_t r =
            radius > 255.0f ? 255 : (uint8_t)(radius + 0.5f);


        if (r > diag.trace[bin]) {
            diag.trace[bin] = r;
        }
    }


    // ------------------------------------------------------------------------
    // REST POSITION
    // ------------------------------------------------------------------------
    //
    // Record where the stick settles once it has been still for a moment
    // near the middle. A stick that settles well away from zero is not
    // returning to center (worn spring, debris, or mis-calibrated at power-on).
    //

    if (moved || steady_since_us == 0) {

        steady_since_us =
            now;
    }

    else if (now - steady_since_us >= REST_SETTLE_US) {

        int16_t near_center =
            profile->reference_reach / 4;


        bool in_center_zone =
            abs(x) <= near_center &&
            abs(y) <= near_center;


        if (
            in_center_zone &&
            (
                !diag.rest_valid ||
                diag.rest_x != x ||
                diag.rest_y != y
            )
        ) {

            diag.rest_valid = true;
            diag.rest_x = x;
            diag.rest_y = y;

            changed = true;
        }
    }


    return changed;
}


// ============================================================================
// ACCESSORS
// ============================================================================

const joystick_diag_t* joystick_diag_get(void)
{
    return &diag;
}


const joystick_profile_t* joystick_diag_get_profile(void)
{
    return profile;
}


joystick_verdict_t joystick_diag_get_verdict(void)
{
    // Every direction must have been pushed at least halfway before the
    // reach figures mean anything.

    int16_t halfway =
        profile->reference_reach / 2;


    if (
        diag.reach_up < halfway ||
        diag.reach_down < halfway ||
        diag.reach_left < halfway ||
        diag.reach_right < halfway
    ) {

        return JOYSTICK_VERDICT_INCOMPLETE;
    }


    if (
        diag.rest_valid &&
        (
            abs(diag.rest_x) > profile->center_tolerance ||
            abs(diag.rest_y) > profile->center_tolerance
        )
    ) {

        return JOYSTICK_VERDICT_OFF_CENTER;
    }


    int16_t weakest =
        diag.reach_up;

    if (diag.reach_down < weakest) weakest = diag.reach_down;
    if (diag.reach_left < weakest) weakest = diag.reach_left;
    if (diag.reach_right < weakest) weakest = diag.reach_right;


    if (weakest >= profile->good_reach) {
        return JOYSTICK_VERDICT_GOOD;
    }


    if (weakest >= profile->fair_reach) {
        return JOYSTICK_VERDICT_FAIR;
    }


    return JOYSTICK_VERDICT_WORN;
}
