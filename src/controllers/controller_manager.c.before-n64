// controller_manager.c
//
// TEMPORARY GAMECUBE-ONLY DIAGNOSTIC
//
// This intentionally bypasses RetroPad Link's controller detection logic
// and exposes JoypadOS's native GameCube input interface directly.
//
// This does NOT modify any SNES source files.
// It is only a temporary firmware test to determine whether the native
// GameCube driver still works in the current RetroPad Link build.

#include "controller_manager.h"

#include "native/host/gc/gc_host.h"


// ============================================================================
// INPUT INTERFACE
// ============================================================================
//
// Return JoypadOS's native GameCube interface directly.
//
// This gives JoypadOS the exact same:
//
//     .init = gc_host_init
//     .task = gc_host_task
//     .is_connected = gc_host_is_connected
//
// path used by the known-good GC configuration.
//

const InputInterface*
retropad_controller_manager_get_input_interface(void)
{
    return &gc_input_interface;
}


// ============================================================================
// ACTIVE CONTROLLER
// ============================================================================

retropad_controller_type_t
retropad_controller_manager_get_active(void)
{
    return RETROPAD_CONTROLLER_GAMECUBE;
}


// ============================================================================
// CONNECTION STATUS
// ============================================================================

bool
retropad_controller_manager_is_connected(void)
{
    return gc_host_is_connected();
}


// ============================================================================
// CONTROLLER NAME
// ============================================================================

const char*
retropad_controller_manager_get_name(void)
{
    return "GAMECUBE";
}
