void ui_draw_raw_screen(uint32_t buttons)
{
    char value[24];


    display_clear();


    display_text(
        0,
        0,
        "RAW INPUT"
    );


    ui_draw_page_indicator(
        TEST_PAGE_RAW
    );


    display_text(
        0,
        18,
        "BUTTON MASK:"
    );


    snprintf(
        value,
        sizeof(value),
        "0x%08lX",
        (unsigned long)buttons
    );


    display_text(
        24,
        30,
        value
    );


    int8_t type =
        retropad_snes_get_device_type();


    snprintf(
        value,
        sizeof(value),
        "TYPE: %d",
        type
    );


    display_text(
        36,
        46,
        value
    );


    display_update();
}


