// ============================================================================
// DRAW CURRENT PAGE
// ============================================================================

void ui_draw_current_test_page(
    test_page_t page,
    uint32_t buttons,
    uint16_t ticker_offset
)
{
    switch (page) {

        case TEST_PAGE_LIVE:

            ui_draw_live_screen(
                buttons
            );

            break;


        case TEST_PAGE_JOYSTICKS:

            ui_draw_joysticks_screen();

            break;


        case TEST_PAGE_DIAGNOSTICS:

            ui_draw_diagnostics_screen(
                ticker_offset
            );

            break;


        case TEST_PAGE_RAW:

            ui_draw_raw_screen(
                buttons
            );

            break;


        default:

            ui_draw_live_screen(
                buttons
            );

            break;
    }
}
