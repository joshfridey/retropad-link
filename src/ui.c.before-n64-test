// ============================================================================
// DIAGNOSTICS
// ============================================================================

void ui_draw_diagnostics_screen(uint16_t ticker_offset)
{
    uint8_t pass_count = 0;
    uint8_t chatter_count = 0;
    uint8_t dropout_count = 0;


    diagnostics_get_counts(
        &pass_count,
        &chatter_count,
        &dropout_count
    );


    char line[24];


    display_clear();


    display_text(
        0,
        0,
        "DIAGNOSTICS"
    );


    ui_draw_page_indicator(
        TEST_PAGE_DIAGNOSTICS
    );


    snprintf(
        line,
        sizeof(line),
        "PASS: %u/%u",
        pass_count,
        (unsigned int)DIAGNOSTICS_BUTTON_COUNT
    );


    display_text(
        0,
        12,
        line
    );


    snprintf(
        line,
        sizeof(line),
        "CHATTER: %u",
        chatter_count
    );


    display_text(
        0,
        24,
        line
    );


    snprintf(
        line,
        sizeof(line),
        "DROPOUT: %u",
        dropout_count
    );


    display_text(
        0,
        36,
        line
    );


    ui_draw_diagnostics_ticker(
        ticker_offset
    );


    display_text(
        1,
        56,
        "RST:ST+SEL+DOWN"
    );


    display_update();
}


