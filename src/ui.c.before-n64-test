// ============================================================================
// PAGE INDICATOR
// ============================================================================
//
// Current page is represented by *
// Other pages are represented by .
//
// LIVE         *...
// JOYSTICKS    .*..
// DIAGNOSTICS  ..*.
// RAW          ...*
//

static void ui_draw_page_indicator(test_page_t page)
{
    const char* indicator = "*...";


    switch (page) {

        case TEST_PAGE_LIVE:
            indicator = "*...";
            break;

        case TEST_PAGE_JOYSTICKS:
            indicator = ".*..";
            break;

        case TEST_PAGE_DIAGNOSTICS:
            indicator = "..*.";
            break;

        case TEST_PAGE_RAW:
            indicator = "...*";
            break;

        default:
            indicator = "*...";
            break;
    }


    display_text(
        98,
        0,
        indicator
    );
}


// ============================================================================
// DIAGNOSTIC TICKER
// ============================================================================

static void ui_draw_diagnostics_ticker(uint16_t offset)
{
    char message[160];

    diagnostics_build_ticker(
        message,
        sizeof(message)
    );


    size_t length =
        strlen(message);


    char visible[22];

    memset(
        visible,
        0,
        sizeof(visible)
    );


    if (length <= 21) {

        snprintf(
            visible,
            sizeof(visible),
            "%s",
            message
        );
    }

    else {

        size_t cycle_length =
            length + 3;


        for (size_t i = 0; i < 21; i++) {

            size_t index =
                (offset + i) % cycle_length;


            if (index < length) {

                visible[i] =
                    message[index];
            }

            else {

                visible[i] =
                    ' ';
            }
        }


        visible[21] =
            '\0';
    }


    display_text(
        1,
        48,
        visible
    );
}


