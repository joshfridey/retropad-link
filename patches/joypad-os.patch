+uint32_t snes_host_get_buttons(uint8_t port)
+{
+    if (!initialized || port >= SNES_MAX_PORTS) {
+        return 0;
+    }
+
+    snespad_t* pad = &snes_pads[port];
+
+    if (pad->type == SNESPAD_NONE) {
+        return 0;
+    }
+
+    if (pad->type == SNESPAD_NES) {
+        return map_nes_to_usbr(pad);
+    }
+
+    if (pad->type == SNESPAD_CONTROLLER) {
+        return map_snes_to_usbr(pad);
+    }
+
+    return 0;
+}
